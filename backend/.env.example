# Server Configuration
# Run `docker compose -f deployment/docker-compose.yml up -d` first to start infrastructure.
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD:-postgres}@localhost:5432/photo_audit?sslmode=disable

# Redis Configuration
REDIS_URL=redis://:${REDIS_PASSWORD:-redispassword}@localhost:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-minioadmin}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD:-minioadmin}
MINIO_BUCKET=audit-platform

# AI Model APIs
AGNES_API_KEY=sk-your-agnes-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Local rule-based fallback (enabled by default)
# When true, uses keyword matching if AI API is unavailable/quota-exhausted.
FALLBACK_ENABLED=true

# JWT Configuration
# MUST be at least 32 characters for security
JWT_SECRET=${JWT_SECRET:-change-me-in-production-use-a-random-string}
JWT_EXPIRY=24h

# Security Configuration
# CORS origin allowlist (comma-separated). * allows all origins — dev only!
ALLOWED_ORIGINS=http://localhost:3000
# Max request body size in bytes (default 100MB)
MAX_UPLOAD_BYTES=104857600
# bcrypt password hashing cost (4-31, default 10)
BCRYPT_COST=10

# Logging Configuration
# Optional: enable file logging with automatic rotation
# LOG_FILE=logs/audit-platform.log

# Schema migrations (auto-run on startup)
MIGRATE_AUTO_UP=false

# Kafka (Phase 2)
KAFKA_BROKERS=localhost:9092

# Elasticsearch (Phase 3)
ELASTICSEARCH_URL=http://localhost:9200
